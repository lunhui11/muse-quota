# 用 enroll --save-user 自动写入准确的微信 sender ID。
ALLOWED_USER_IDS=
# install.sh 将以下路径替换为独立私有目录。
WECHAT_MUSE_DATA_DIR=/path/to/private/wechat-data
TASK_POOL_BASE_URL=http://127.0.0.1:8788
# task：普通文本直接建任务，不需要 Gadget；chat：普通文本进入 Gadget Side Chat。
WECHAT_DEFAULT_MODE=task
MUSEGADGET_COMMAND=musegadget
MAX_MESSAGE_CHARS=8000
ILINK_API_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_POLL_TIMEOUT_MS=5000
HTTP_TIMEOUT_SECONDS=45
DEBUG_PAYLOADS=false
