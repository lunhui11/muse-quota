# 本地默认地址；云端容器由 Dockerfile 设置监听地址。
HOST=127.0.0.1
PORT=8788
PROBE_INTERVAL_MINUTES=30
PAUSE_AT_PERCENT=90
ALLOW_LOGIN=1
# 本机 Windows 使用已安装的 Chrome；Linux 留空使用 Playwright Chromium。
# BROWSER_CHANNEL=chrome
# BROWSER_EXECUTABLE_PATH=/absolute/path/to/chrome
# DATA_DIR=C:/path/to/private/muse-data
# 代理认证示例。请填写你自己的值，不要提交 .env。
# MUSE_A_PROXY_USER=
# MUSE_A_PROXY_PASSWORD=

# 账号池每天同步文本资料的小时，使用北京时间。
DAILY_SYNC_HOUR=8
# 从每个绑定目录每日读取 txt/md/json；完成 OAuth 和目录绑定后设为 1。
DRIVE_IMPORT_ENABLED=0
# 内置执行器由面板「启动自动执行」开启；重启后默认关闭。
EXECUTOR_HEADLESS=1
EXECUTOR_TIMEOUT_SECONDS=300
# 每次领取最多执行这些步骤，达到上限后等待人工检查。
EXECUTOR_MAX_STEPS=20
# Google Drive 上传身份；用安全方式配置，不要提交真实值。
# DRIVE_OAUTH_CLIENT_ID=
# DRIVE_OAUTH_CLIENT_SECRET=
# DRIVE_OAUTH_REFRESH_TOKEN=
# 仅让 Google Drive OAuth 和 API 请求走本机 HTTP 代理。
# DRIVE_PROXY_URL=http://127.0.0.1:17890
# 或使用已有 Google 用户凭据文件，路径应在 data/ 内或仓库外。
# DRIVE_CREDENTIALS_FILE=
