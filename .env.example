# 本地默认地址；云端容器由 Dockerfile 设置监听地址。
HOST=127.0.0.1
PORT=8788
PROBE_INTERVAL_MINUTES=30
PAUSE_AT_PERCENT=90
ALLOW_LOGIN=1
# 本机 Windows 使用已安装的 Chrome；Linux 留空使用 Playwright Chromium。
# BROWSER_CHANNEL=chrome
# DATA_DIR=C:/path/to/private/muse-data
# 代理认证示例。请填写你自己的值，不要提交 .env。
# MUSE_A_PROXY_USER=
# MUSE_A_PROXY_PASSWORD=
